#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
remote_name=$1
message_file=$(mktemp)
trap 'rm -f -- "$message_file"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

while read -r local_ref local_oid remote_ref remote_oid
do
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac
    case "$remote_oid" in
        *[!0]*)
            if git cat-file -e "$remote_oid" 2>/dev/null; then
                commits=$(git rev-list "$remote_oid..$local_oid")
            else
                commits=$(git rev-list "$local_oid" --not --remotes="$remote_name")
            fi
            ;;
        *)
            commits=$(git rev-list "$local_oid" --not --remotes="$remote_name")
            ;;
    esac
    for commit in $commits
    do
        git log -1 --format=%B "$commit" > "$message_file"
        if ! "$repo_root/.githooks/commit-msg" "$message_file"; then
            printf 'pre-push: invalid message in commit %s (%s)\n' "$commit" "$local_ref" >&2
            exit 1
        fi
    done
done
